---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

// OPERATOR: every page should pass its own title + description. These are the
// two highest-impact on-page SEO fields — see prompts/seo-update.md for how to
// fill them in for a real project.
const title = 'Astro + Tailwind Starter';
const description =
	'A production-ready Astro + Tailwind CSS starter template with SEO, sitemap, and a working contact form baked in.';
---

<BaseLayout title={title} description={description}>
	<main class="grid place-items-center h-screen content-center">
		<h1 class="sr-only">{title}</h1>
		<Button>Tailwind Button in Astro!</Button>
		<a href="/markdown-page" class="p-4 underline">Markdown is also supported...</a>
	</main>
</BaseLayout>
