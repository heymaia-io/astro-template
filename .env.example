# --- Frontend (baked into the build by Astro) ---
# Cloudflare Turnstile site key (public — visible in built HTML).
# Get it from: https://dash.cloudflare.com → Turnstile → your site.
#
# The default below is Cloudflare's public "always passes" test key — works on
# any hostname (including localhost) so the Docker workflow runs out of the box.
# REPLACE with your real site key before deploying to production.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- FTP deploy (used by `pnpm deploy` → scripts/deploy.py) ---
# Hostinger FTP credentials. Find them in hPanel → Files → FTP Accounts.
# FTP_HOST must be a bare hostname or IP — no "ftp://" prefix.
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
# Leave empty when the FTP account already lands inside the site root
# (Hostinger chroots FTP accounts into /home/<user>/domains/<domain>/public_html
# automatically). Set to a path only if you need to upload elsewhere.
FTP_REMOTE_DIR=
# Connection options (defaults: 21 / true). Hostinger supports FTPS.
FTP_PORT=21
FTP_USE_TLS=true
# Skip TLS cert hostname verification. Only set to "false" if you must connect
# by IP address (the cert is then valid but won't match the IP). Prefer using
# the hostname Hostinger lists so this stays "true".
FTP_TLS_VERIFY=true
